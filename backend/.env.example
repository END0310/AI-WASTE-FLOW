# ---- Google Gemini (backend only; NEVER use a NEXT_PUBLIC_ prefix) ----
GEMINI_API_KEY=your_gemini_api_key_here
# Verify the model ID is available to your key before release (Spec 8.2)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
AI_VALIDATION_RETRIES=1
PROMPT_VERSION=wasteflow-ai-v1
AI_OUTPUT_LANGUAGE=Bahasa Indonesia

# Local dev only: deterministic mock when no key is set. Keep false in production.
AI_ALLOW_MOCK=false

# ---- Guardrails ----
AI_ANALYSIS_COOLDOWN_SECONDS=30
AI_MAX_PAYLOAD_BYTES=60000

# ---- Database (relative sqlite paths resolve to the backend/ folder) ----
DATABASE_URL=sqlite:///./wasteflow.db

# ---- Security ----
CORS_ORIGINS=http://localhost:3000
# Dev-only run seeding endpoint; set false when embedded in the main system
ENABLE_DEV_ENDPOINTS=true
